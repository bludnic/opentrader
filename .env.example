########## SHARED - ##########

# Relative to packages/prisma/src
DATABASE_URL="file:../../../dev.db"
ADMIN_PASSWORD=opentrader
# Logging level for ccxt
# Accepts: "true" | ""
CCXT_VERBOSE=
# Custom HOST. Default is localhost
HOST=
# Custom port. Default is 4000
PORT=
# Path to custom strategies dir. Should be a full path.
CUSTOM_STRATEGIES_PATH=
# Optional: 64-char hex (32-byte) key used to encrypt exchange account credentials at rest.
# If unset, a key is auto-generated on first run and stored at ~/.opentrader/credentials.key.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENCRYPTION_KEY=
########## SHARED END ######
